{
  "dependencies": {
    "@waline/client": "^3.16.1",
    "axios": "^1.20.0",
    "blueimp-md5": "^2.19.0",
    "qrcode.vue": "^3.11.0"
  },
  "devDependencies": {
    "@types/blueimp-md5": "^2.18.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "markdown-it-mathjax3": "^4.3.2",
    "medium-zoom": "^1.1.0",
    "playwright": "^1.64.1",
    "schema-dts": "^2.1.0",
    "typescript": "6.0.3",
    "vite-plus": "catalog:",
    "vitepress": "2.0.0-alpha.20",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "vp config --no-agent",
    "pdf:single": "node scripts/export-pdf.js --list scripts/pdf-repo-test.txt --out-dir pdf-repo-single --concurrency 1",
    "pdf:all": "node scripts/export-pdf.js --concurrency 4",
    "check": "vp check && vp run typecheck && vp run test:pages",
    "test:pages": "node --test scripts/page-rules.test.ts"
  },
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
